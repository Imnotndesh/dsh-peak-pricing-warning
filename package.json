{
  "name": "@imnotndesh/dsh-peak-pricing-warning",
  "version": "1.0.0",
  "description": "Shows DeepSeek peak and off-peak pricing windows and a live countdown in the DeepSeek Harness web GUI.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "pricing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Imnotndesh/dsh-peak-pricing-warning.git"
  }
